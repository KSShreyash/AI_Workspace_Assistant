# backend/.env.cloud.example
#
# Values for the CLOUD stack. In production these are set in the Render
# dashboard rather than in a file - copy this to backend/.env only if you want
# your local machine to talk to the cloud project instead of the local one.
#
# THE ONE RULE: the database and Auth must be the same Supabase instance.
# profiles.id has a foreign key to auth.users(id), and JWT verification follows
# SUPABASE_URL, so a local database paired with cloud Auth cannot work - a user
# id minted by cloud Auth violates the foreign key against the local auth.users.
# Switch all three Supabase values together, never individually.

# --- Supabase (cloud project) -------------------------------------------------
# USE THE SESSION POOLER, NOT THE DIRECT CONNECTION.
#
# db.PROJECT_REF.supabase.co publishes only an AAAA record - it is IPv6-only.
# Render's free tier is IPv4, so a direct connection fails there with
# "Network is unreachable", which reads like the database is down rather than
# unreachable by that route. Verified by DNS lookup on 2026-10-15: the direct
# host had no A record; the pooler host did.
#
# Session pooler (port 5432), not transaction pooler (6543): asyncpg uses
# prepared statements, which pgbouncer's transaction mode does not support.
# Transaction mode works only with statement_cache_size=0 on the connection.
#
# Copy the exact string from Dashboard -> Connect -> Session pooler; the region
# prefix differs per project (aws-0-... and aws-1-... both exist for ap-south-1).
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-N-REGION.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://PROJECT_REF.supabase.co

# --- Encryption ---------------------------------------------------------------
# Use the SAME value as the local stack if you want tokens connected locally to
# remain readable. Never rotate this once tokens are stored: every encrypted
# access and refresh token becomes permanently undecryptable and every mailbox
# has to be reconnected by hand.
FERNET_KEY=

# --- Microsoft Graph ----------------------------------------------------------
# Same Azure app as local. The redirect URI registered in Azure differs though:
#   local      http://localhost:54321/auth/v1/callback
#   cloud      https://PROJECT_REF.supabase.co/auth/v1/callback
# Register both so one app serves both environments.
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_AUTHORITY=https://login.microsoftonline.com/common

# --- Google (Gmail + Google Calendar) -----------------------------------------
# Same Google Cloud OAuth client as local, with both redirect URIs registered.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Misc ---------------------------------------------------------------------
# Comma-separated, NO SPACE after the comma - origins are compared literally, so
# a leading space silently never matches. Must contain the real Cloudflare Pages
# domain; keep localhost so you can point a local frontend at the cloud API.
CORS_ALLOW_ORIGINS=https://ai-workspace-assistant.pages.dev,http://localhost:3000

# Guards the bulk-sync endpoint. Nothing calls it on a schedule by default;
# set it anyway so the endpoint is never left unprotected.
SYNC_SECRET=

# --- LLM ----------------------------------------------------------------------
# Groq's free tier, shared with the local stack. The limit that binds first is
# tokens per day (200k), not requests per day.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
EXTRACTION_BATCH_LIMIT=50
