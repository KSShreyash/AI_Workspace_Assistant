# backend/.env.example
#
# LOCAL DEV: run `npx supabase start --debug` from the repo root, then run
# `npx supabase status` and copy the printed values into the marked fields.
# Those local keys are fixed development values, not secrets.
#
# PRODUCTION: these are set in the Render dashboard, not in a file.
# See docs/superpowers/specs/2026-10-08-multi-provider-email-and-free-llm-design.md §11.

# --- Supabase -----------------------------------------------------------------
# The database and Auth MUST be the same Supabase instance: profiles.id has a
# foreign key to auth.users(id), so a local DB cannot be paired with cloud Auth.
# local:      postgresql://postgres:postgres@127.0.0.1:54322/postgres
# production: postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
DATABASE_URL=

# local: http://localhost:54321     production: https://PROJECT_REF.supabase.co
SUPABASE_URL=

# from `npx supabase status` (service_role key)
SUPABASE_SERVICE_ROLE_KEY=

# --- Encryption ---------------------------------------------------------------
# Generate once:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# NEVER rotate this on an environment with stored tokens - every encrypted
# Microsoft Graph token becomes permanently undecryptable.
FERNET_KEY=

# --- Microsoft Graph ----------------------------------------------------------
# From the Azure app registration. /common accepts BOTH personal accounts
# (outlook.com, hotmail) and work/school accounts - no change needed for personal mail.
# The Azure redirect URI must point at Supabase, not at this app:
#   local:      http://localhost:54321/auth/v1/callback
#   production: https://PROJECT_REF.supabase.co/auth/v1/callback
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_AUTHORITY=https://login.microsoftonline.com/common

# --- Misc ---------------------------------------------------------------------
# Comma-separated, NO SPACE after the comma - origins are compared literally,
# so a leading space silently never matches.
CORS_ALLOW_ORIGINS=http://localhost:3000

# Shared secret for POST /api/sync/run (the GitHub Actions cron).
# Must match the SYNC_SECRET repo secret exactly. Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SYNC_SECRET=

# --- LLM ----------------------------------------------------------------------
# Any OpenAI-compatible endpoint. Groq by default: its response_format shape
# matches the strict json_schema this app already sends, so the client is the
# stock `openai` SDK pointed at a different base_url.
#
# Groq free tier, per model: 30 req/min, 1000 req/day, 8k tokens/min,
# 200k tokens/day. Tokens/day binds long before requests/day.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
# Models supporting strict structured output: openai/gpt-oss-20b,
# openai/gpt-oss-120b, qwen/qwen3.8-27b. All share the same limits, so prefer
# the cheapest per token.
LLM_MODEL=openai/gpt-oss-20b

# Items processed per extraction run. Defaults to 50 if unset.
EXTRACTION_BATCH_LIMIT=50
