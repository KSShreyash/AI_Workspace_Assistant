# frontend/.env.cloud.example
#
# Values for the CLOUD stack. In production these are set in the Cloudflare Pages
# dashboard. Copy to frontend/.env.local only if you want a local frontend to
# talk to the cloud backend.
#
# These are INLINED AT BUILD TIME, not read at runtime. Changing one requires a
# rebuild, not a restart - a redeploy without a rebuild keeps the old values
# baked into the bundle.
#
# Must point at the same Supabase project the backend uses: the backend verifies
# JWTs against this project's published keys, so a mismatch fails every request.

NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_BASE_URL=https://ai-workspace-assistant-api.onrender.com
